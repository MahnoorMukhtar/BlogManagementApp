{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/server.js",
            "methods": [
                "GET",
                "POST",
                "PATCH",
                "DELETE",
                "PUT",
                "OPTIONS"
            ],
            "headers": {
                "Access-Control-Allow-Origin": "https://blog-frontend-three-sooty.vercel.app/"
            }
        }
    ]
}